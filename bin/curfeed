#!/bin/sh
# curfeed: 決めた時間帯以外は、SNS などのサイトを見られなくする。使い方は `curfeed help`

set -eu
set -f

LIBEXEC=$(cd "$(dirname "$0")/../libexec/curfeed" 2> /dev/null && pwd) || {
  echo "curfeed: libexec/curfeed が見つかりません。install.sh でインストールし直してください" >&2
  exit 1
}
. "$LIBEXEC/lib.sh"

DAEMON_LABEL=local.curfeed

die() {
  echo "curfeed: $*" >&2
  exit 1
}

usage() {
  cat << 'EOF'
使い方: curfeed <コマンド> [引数]

  status                  今の状態と、次に切り替わる時刻を表示する（引数なしでも同じ）
  list                    ブロックするドメインを表示する
  add <ドメイン>...        ブロックするドメインを追加する（URL を貼り付けてもよい）
  remove <ドメイン>...     ブロックするドメインを削除する
  set-time <開始-終了>...  許可時間帯をまとめて置き換える（例: curfeed set-time 12:00-13:00 21:00-22:00）
  log [件数]               切り替えとタブを閉じた記録を表示する（既定は 20 件）
  uninstall [--purge] [--yes]
                           curfeed をアンインストールし、hosts のブロックも解除する
                           （--purge で設定・ログなども削除、--yes で確認を省く）
  help                     この説明を表示する

add / remove / set-time / uninstall は管理者権限で実行します（必要ならパスワードを求めます）。
EOF
}

# 設定と hosts を書き換えられなければ、同じコマンドを sudo で実行し直す。引数: 元のコマンドと引数
require_write() {
  if [ -w "$CURFEED_BLOCKLIST" ] && [ -w "$CURFEED_CONFIG" ] && [ -w "$CURFEED_HOSTS" ]; then
    return 0
  fi
  [ "$(id -u)" -ne 0 ] || die "書き込めません: $CURFEED_ETC と $CURFEED_HOSTS を確認してください"
  echo "管理者権限が必要です。sudo で実行し直します" >&2
  exec sudo "$0" "$@"
}

# 変更をすぐ hosts に反映し、結果をログに残す
apply_now() {
  sh "$LIBEXEC/apply" >> "$CURFEED_APPLY_LOG" 2>&1 \
    || die "hosts への反映に失敗しました（curfeed log で確認してください）"
}

# URL やドメインからホスト名（小文字）を取り出す
host_of() {
  _x=${1#*://}
  _x=${_x%%/*}
  _x=${_x%%\?*}
  _x=${_x%%#*}
  _x=${_x##*@}
  _x=${_x%:*}
  printf '%s\n' "$_x" | tr 'A-Z' 'a-z'
}

# 分を「1時間30分」の形で表す
format_duration() {
  _h=$(($1 / 60))
  _m=$(($1 % 60))
  if [ "$_h" -eq 0 ]; then
    echo "${_m}分"
  elif [ "$_m" -eq 0 ]; then
    echo "${_h}時間"
  else
    echo "${_h}時間${_m}分"
  fi
}

require_blocklist() {
  [ -r "$CURFEED_BLOCKLIST" ] || die "blocklist を読めません: $CURFEED_BLOCKLIST"
}

# 次に切り替わる時刻（HHMM）を出す。引数: 現在 許可時間帯 許可中なら 1
# 許可中なら今いる許可時間帯の終わり、ブロック中なら次に始まる許可時間帯の始まり
next_switch() {
  _best=""
  _best_left=1441
  for _w in $2; do
    if [ "$3" -eq 1 ]; then
      if in_window "$1" "${_w%-*}" "${_w#*-}"; then
        echo "${_w#*-}"
        return 0
      fi
    else
      _left=$((($(to_minutes "${_w%-*}") - $(to_minutes "$1") + 1440) % 1440))
      if [ "$_left" -lt "$_best_left" ]; then
        _best=${_w%-*}
        _best_left=$_left
      fi
    fi
  done
  echo "$_best"
}

cmd_status() {
  now=$(curfeed_now)
  to_minutes "$now" > /dev/null || die "現在時刻が不正です: $now"
  load_windows || die "$curfeed_error"
  require_blocklist
  if in_any_window "$now" "$allow_windows"; then
    state=許可中
    next_label=次のブロック
    allowed=1
    should_block=0
  else
    state=ブロック中
    next_label=次の解除
    allowed=0
    should_block=1
  fi
  window=$(format_windows "$allow_windows")
  if is_full_day "$allow_windows"; then
    full_day=1
    window="${window}（24時間）"
    next_line="$next_label: なし"
  else
    full_day=0
    next=$(next_switch "$now" "$allow_windows" "$allowed")
    left=$((($(to_minutes "$next") - $(to_minutes "$now") + 1440) % 1440))
    next_line="$next_label: $(format_time "$next")（あと$(format_duration "$left")）"
  fi
  count=$(blocklist_domains | awk 'END { print NR }')
  if [ -n "$(blocked_hosts)" ]; then is_blocked=1; else is_blocked=0; fi

  echo "状態: $state"
  echo "許可時間帯: $window"
  echo "$next_line"
  echo "ブロック対象: $count ドメイン"
  if [ "$full_day" -eq 1 ]; then
    echo "※ 許可時間帯が24時間なので、何もブロックしません。curfeed set-time 21:00-22:00 のように決めてください"
  fi
  if [ "$count" -eq 0 ]; then
    echo "※ ブロックするドメインがありません。curfeed add youtube.com のように登録してください"
  elif [ "$is_blocked" -ne "$should_block" ]; then
    echo "※ hosts にはまだ反映されていません（通常1分以内に反映されます。続く場合は curfeed log を確認してください）"
  fi
  if launchctl print "system/$DAEMON_LABEL" > /dev/null 2>&1; then
    echo "自動切り替え: 動作中"
  else
    echo "自動切り替え: 停止中（install.sh でインストールしてください）"
  fi
}

cmd_list() {
  require_blocklist
  domains=$(blocklist_domains)
  if [ -n "$domains" ]; then
    printf '%s\n' "$domains"
  else
    echo "ブロックするドメインは登録されていません（curfeed add youtube.com のように登録できます）"
  fi
}

cmd_add() {
  [ $# -gt 0 ] || die "追加するドメインを指定してください（例: curfeed add tiktok.com）"
  require_blocklist
  for arg in "$@"; do
    valid_domain "$(host_of "$arg")" || die "ドメインとして不正です: $arg"
  done
  require_write add "$@"

  known=$(blocklist_domains | tr 'A-Z' 'a-z')
  added=""
  for arg in "$@"; do
    d=$(host_of "$arg")
    if printf '%s\n' "$known" | grep -qxF "$d"; then
      echo "登録済みです: $d"
    else
      known="$known
$d"
      added="$added $d"
    fi
  done
  [ -n "$added" ] || return 0

  # 最終行に改行が無いと、追記したドメインが前の行につながってしまう
  if [ -s "$CURFEED_BLOCKLIST" ] && [ -n "$(tail -c 1 "$CURFEED_BLOCKLIST")" ]; then
    echo >> "$CURFEED_BLOCKLIST"
  fi
  for d in $added; do
    echo "$d" >> "$CURFEED_BLOCKLIST"
  done
  apply_now
  echo "追加しました:$added"
}

cmd_remove() {
  [ $# -gt 0 ] || die "削除するドメインを指定してください（例: curfeed remove tiktok.com）"
  require_blocklist
  known=$(blocklist_domains | tr 'A-Z' 'a-z')
  removed=""
  for arg in "$@"; do
    d=$(host_of "$arg")
    printf '%s\n' "$known" | grep -qxF "$d" || die "登録されていません: $d"
    removed="$removed $d"
  done
  require_write remove "$@"

  tmp=$(mktemp)
  # コメント行や空行は残し、指定したドメインの行だけを除く
  REMOVED="$removed" awk '
    BEGIN {
      n = split(ENVIRON["REMOVED"], list, " ")
      for (i = 1; i <= n; i++) drop[list[i]] = 1
    }
    {
      line = $0
      sub(/#.*/, "", line)
      split(line, f, " ")
      if (tolower(f[1]) in drop) next
      print
    }
  ' "$CURFEED_BLOCKLIST" > "$tmp"
  cat "$tmp" > "$CURFEED_BLOCKLIST"
  rm -f "$tmp"
  apply_now
  echo "削除しました:$removed"
}

# 「21:00-22:00」「2100-2200」を「2100-2200」にそろえる。不正な値なら失敗する
parse_window() {
  case $1 in
    *-*-* | -* | *-) return 1 ;;
    *-*) ;;
    *) return 1 ;;
  esac
  _ps=$(normalize_time "${1%-*}") && _pe=$(normalize_time "${1#*-}") || return 1
  valid_window "$_ps-$_pe" || return 1
  echo "$_ps-$_pe"
}

cmd_set_time() {
  [ $# -gt 0 ] || die "許可時間帯を指定してください（例: curfeed set-time 12:00-13:00 21:00-22:00）"
  # 以前の書き方（curfeed set-time 21:00 22:00）は、1つの許可時間帯として扱う
  case "$*" in
    *-*) ;;
    *)
      [ $# -eq 2 ] || die "許可時間帯は 21:00-22:00 のように指定してください（複数あれば空白で区切って並べます）"
      set -- "$1-$2"
      ;;
  esac
  windows=""
  for arg in "$@"; do
    w=$(parse_window "$arg") \
      || die "許可時間帯が不正です: ${arg}（21:00-22:00 のように指定してください。開始と終了は別の時刻にし、開始に 24:00 は使えません）"
    windows="$windows $w"
  done
  windows=$(merge_windows "$windows")
  require_write set-time "$@"

  write_config "$windows"
  apply_now
  echo "許可時間帯を $(format_windows "$windows") に変更しました"
}

cmd_log() {
  n=${1:-20}
  case $n in
    '' | *[!0-9]*) die "件数は数字で指定してください: $n" ;;
  esac
  # 同じ時刻なら切り替え（curfeed.log）を先に並べる
  logs=$(cat "$CURFEED_APPLY_LOG" "$CURFEED_CLOSE_TABS_LOG" 2> /dev/null | sort -s -k1,2 | tail -n "$n")
  if [ -n "$logs" ]; then
    printf '%s\n' "$logs"
  else
    echo "記録はありません"
  fi
}

cmd_uninstall() {
  confirmed=0
  purge=""
  for opt in "$@"; do
    case $opt in
      -y | --yes) confirmed=1 ;;
      --purge) purge=--purge ;;
      *) die "不明なオプションです: $opt" ;;
    esac
  done
  # install.sh が libexec に置いた uninstall.sh を使う。リポジトリの bin/curfeed から実行したときは無い
  uninstaller="$LIBEXEC/uninstall.sh"
  [ -r "$uninstaller" ] \
    || die "インストールされた curfeed が見つかりません（リポジトリからは sudo ./uninstall.sh でアンインストールできます）"

  if [ "$confirmed" -eq 0 ]; then
    if [ -n "$purge" ]; then
      printf 'curfeed をアンインストールし、hosts のブロックも解除します。設定・ログなども含めてすべて削除します。よろしいですか？ [y/N] '
    else
      printf 'curfeed をアンインストールし、hosts のブロックも解除します。よろしいですか？ [y/N] '
    fi
    read -r answer || answer=""
    case $answer in
      y | Y | yes | YES) ;;
      *)
        echo "中止しました"
        exit 1
        ;;
    esac
  fi

  if [ "$(id -u)" -ne 0 ]; then
    echo "管理者権限が必要です。sudo で実行し直します" >&2
    exec sudo "$0" uninstall --yes $purge
  fi
  exec sh "$uninstaller" $purge
}

cmd=${1:-status}
[ $# -eq 0 ] || shift
case $cmd in
  status) cmd_status ;;
  list) cmd_list ;;
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  set-time) cmd_set_time "$@" ;;
  log) cmd_log "$@" ;;
  uninstall) cmd_uninstall "$@" ;;
  help | -h | --help) usage ;;
  *)
    echo "curfeed: 不明なコマンドです: $cmd" >&2
    usage >&2
    exit 2
    ;;
esac
